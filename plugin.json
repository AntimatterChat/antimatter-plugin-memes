{
    "id": "memes",
    "name": "Memes",
    "description": "Make memes from popular templates, with top, middle and bottom captions, from the Memes tab of the emoji picker or with /meme.",
    "homepage_url": "https://github.com/antimatterchat/antimatter-plugin-memes",
    "support_url": "https://github.com/antimatterchat/antimatter-plugin-memes/issues",
    "icon_path": "assets/icon.svg",
    "version": "1.6.0",
    "min_server_version": "12.0.0",
    "server": {
        "executables": {
            "darwin-amd64": "server/dist/plugin-darwin-amd64",
            "darwin-arm64": "server/dist/plugin-darwin-arm64",
            "linux-amd64": "server/dist/plugin-linux-amd64",
            "linux-arm64": "server/dist/plugin-linux-arm64",
            "windows-amd64": "server/dist/plugin-windows-amd64.exe"
        },
        "executable": ""
    },
    "webapp": {
        "bundle_path": "webapp/dist/main.js"
    },
    "settings_schema": {
        "header": "",
        "footer": "* To report an issue, make a suggestion or a contribution, [check the repository](https://github.com/antimatterchat/antimatter-plugin-memes).",
        "settings": [
            {
                "key": "WhoCanAddTemplates",
                "display_name": "Who can add meme templates",
                "type": "dropdown",
                "default": "everyone",
                "help_text": "Who can add meme templates of their own from the Memes tab of the emoji picker. Everyone can use them once they're added; their creators and system admins can delete them. Nobody turns custom templates off: the ones already added stay usable.",
                "options": [
                    {
                        "display_name": "Everyone",
                        "value": "everyone"
                    },
                    {
                        "display_name": "System admins",
                        "value": "admins"
                    },
                    {
                        "display_name": "Nobody (custom templates off)",
                        "value": "nobody"
                    }
                ]
            }
        ]
    }
}
